{
  "manifest_version": 3,
  "name": "Kick 弹幕",
  "version": "1.2.1",
  "description": "将 Kick 实时聊天显示为播放器弹幕。",
  "permissions": ["storage"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "assets/icon-16.png", "32": "assets/icon-32.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://kick.com/*", "https://www.kick.com/*"],
      "js": [
        "settings.js", "storage.js", "page-start.js", "realtime.js", "overlay.js", "composer.js",
        "panel-controls.js", "panel-template.js", "chat-menu.js"
      ],
      "css": ["overlay.css", "composer.css", "chat-menu.css"],
      "run_at": "document_idle"
    }
  ]
}
